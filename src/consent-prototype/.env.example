# Copy to .env to override the local defaults. These are NOT used on Render (see render.yaml).
INTERNAL_SERVICE_TOKEN=internal-service-token
KEY_ANALYTICS_CO=key-analytics-001
KEY_MAILER_CO=key-mailer-002
KEY_RESEARCH_LAB=key-research-003
# Optional: password-protects the web console (HTTP Basic, any username). Leave empty for an open console.
CONSOLE_PASSWORD=
# 1 = Swagger UI at /docs (local). Render turns it off.
ENABLE_DOCS=1
# Swagger UI / OpenAPI at /docs. 1 locally; render.yaml turns it off on Render.
ENABLE_DOCS=1
